# Dilamme Job Scheduler - Backend Configuration
# Copy this file to .env and adjust values for your environment.
# Systemd services read this file from /home/ubuntu/job_scheduler/backend/.env

# --- Database ---
# For SQLite (default):
DATABASE_URL=sqlite:///./scheduler.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/job_scheduler

# --- API URL (Worker -> API) ---
# The worker uses this URL to reach the FastAPI backend.
# In production, this is the local address since the worker runs on the same machine:
API_URL=http://127.0.0.1:8000

# --- CORS ---
# Comma-separated list of allowed origins (no spaces).
# Set this to your frontend domain (e.g., https://my-scheduler.duckdns.org):
CORS_ORIGINS=https://jobs.example.com

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
