[Unit]
Description=Dilamme Job Scheduler - FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/job_scheduler

# Environment variables
EnvironmentFile=/home/ubuntu/job_scheduler/backend/.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/ubuntu/job_scheduler/.venv/bin/uvicorn backend.api:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectHome=false
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
